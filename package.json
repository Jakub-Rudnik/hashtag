{
  "name": "hashtag",
  "version": "1.0.0",
  "description": "Share Markdown files as nice-looking links",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "wrangler types && tsc && tsc -p test",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "test": "vitest run"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.18.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.18.0",
  "type": "module",
  "dependencies": {
    "highlight.js": "^11.12.0",
    "hono": "^4.13.17",
    "markdown-it": "^15.0.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.7.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "wrangler": "^4.160.0"
  },
  "private": true,
  "license": "MIT"
}
