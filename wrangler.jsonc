{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hashtag",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },

  // Static files (CSS, fonts) served straight from Cloudflare's edge.
  "assets": { "directory": "./public" },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hashtag",
      // Placeholder for local dev. After `wrangler d1 create hashtag`, paste the real id here.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],

  // Set with `wrangler secret put <NAME>` (production) or in .dev.vars (local).
  "secrets": { "required": ["ADMIN_PASSWORD", "SESSION_SECRET", "API_TOKEN"] },

  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "hashtag-docs" }]
}
